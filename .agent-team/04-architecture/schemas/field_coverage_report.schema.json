{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://72offsuit.local/ai-roi/measurement-publish/v1/field_coverage_report.schema.json",
  "title": "results/measurement/field_coverage_report.json — V3 필드 충족률",
  "description": "'어떤 필드가 비어 있는가' 에 답한다. NOT_APPLICABLE 은 분모에서 제외한다(sink.py FieldCoverage). 22개 필드 전부가 키로 존재해야 한다.",
  "type": "object",
  "required": [
    "contract_version",
    "artifact",
    "run_id",
    "generated_at",
    "timezone",
    "provenance",
    "notices",
    "fields",
    "missing_fields",
    "schema_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "artifact": {
      "const": "field_coverage_report"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/kst_timestamp"
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/notice"
      }
    },
    "fields": {
      "type": "object",
      "description": "DATA-003 22개 필드 전부. 한 건도 안 들어온 필드를 목록에서 빼지 않는다.",
      "minProperties": 22,
      "maxProperties": 22,
      "additionalProperties": {
        "type": "object",
        "required": [
          "group",
          "fill_rate",
          "blocks_metrics"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "enum": [
              "core",
              "session",
              "product",
              "order",
              "marketing",
              "meta"
            ]
          },
          "fill_rate": {
            "$ref": "common.schema.json#/$defs/source_split"
          },
          "applicable_event_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks_metrics": {
            "type": "array",
            "description": "★ 이 필드가 결손일 때 계산할 수 없게 되는 지표들. 화면이 결손→영향 사슬을 추론하지 않게 게시 시점에 넣는다(DB-012). 역방향은 kpi_report.metrics[].value.blocked_by 다 — 화면은 이 배열을 뒤집어 인덱스를 만들 수 있고, 그것은 같은 데이터의 재배열이지 새 분류가 아니다.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "description": "적용 대상인데 한 건도 값이 없는 필드. sink.manifest().missing_fields 를 그대로 나른다.",
      "items": {
        "type": "string"
      }
    },
    "schema_gaps": {
      "type": "array",
      "description": "★ 계산식이 요구하는데 스키마에 컬럼 자체가 없는 것. field_coverage 는 존재하는 컬럼만 세므로 이 부류는 어디에도 나타나지 않고, 게시하지 않으면 화면에서 영구히 사라진다.",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "required_by_formula",
          "where_it_should_live",
          "blocks_metrics",
          "reason_code",
          "reason_detail"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "없는 것의 이름. 예: discount · unit_cost · shipping_fee · refund"
          },
          "required_by_formula": {
            "type": "string",
            "minLength": 1,
            "description": "이것을 요구하는 계산식"
          },
          "where_it_should_live": {
            "type": "string",
            "minLength": 1,
            "description": "어디에 있어야 하는가. 예: events 22컬럼 · order_items 테이블(미구현)"
          },
          "reason_code": {
            "$ref": "common.schema.json#/$defs/reason_code"
          },
          "reason_detail": {
            "type": "string",
            "minLength": 1
          },
          "decision_ref": {
            "type": "string",
            "description": "이 공백을 다루는 결정 항목. 예: D-3 · D-16 · D-2"
          },
          "blocks_metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "blocks_checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "영향받는 품질 검사 ID"
          }
        }
      }
    }
  }
}

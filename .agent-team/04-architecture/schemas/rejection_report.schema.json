{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://72offsuit.local/ai-roi/measurement-publish/v1/rejection_report.schema.json",
  "title": "results/measurement/rejection_report.json — V2 계약 위반",
  "description": "'무엇이 왜 거부됐는가' 에 답한다. 원천은 Event Sink 의 rejected.jsonl 이다. ★ 거부된 레코드 원문을 게시하지 않는다 — rejected.jsonl 에는 스키마에 없는 필드가 그대로 들어 있어, 원문을 results/ 로 옮기면 금지 필드(Hidden Trait 등)가 대시보드까지 흘러갈 경로가 생긴다. 집계와 화이트리스트 필드만 게시한다.",
  "type": "object",
  "required": [
    "contract_version",
    "artifact",
    "run_id",
    "generated_at",
    "timezone",
    "provenance",
    "notices",
    "totals",
    "by_reason",
    "samples"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "artifact": {
      "const": "rejection_report"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/kst_timestamp"
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/notice"
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "events_rejected",
        "rejection_rate",
        "distinct_reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "events_rejected": {
          "$ref": "common.schema.json#/$defs/metric_value"
        },
        "rejection_rate": {
          "$ref": "common.schema.json#/$defs/metric_value"
        },
        "distinct_reasons": {
          "$ref": "common.schema.json#/$defs/metric_value"
        }
      }
    },
    "by_reason": {
      "type": "array",
      "description": "거부 사유별 집계. reason_key 는 validate_event() 의 위반 메시지를 사유 종류로 정규화한 값이다(원문 메시지를 그대로 키로 쓰면 필드명이 섞여 카디널리티가 폭발한다).",
      "items": {
        "type": "object",
        "required": [
          "reason_key",
          "reason_label",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "reason_key": {
            "enum": [
              "UNKNOWN_EVENT_TYPE",
              "UNKNOWN_FIELD",
              "FORBIDDEN_FIELD",
              "MISSING_REQUIRED_FIELD",
              "NOT_APPLICABLE_FIELD_PRESENT",
              "NEGATIVE_AMOUNT",
              "IDENTIFIER_FORMAT",
              "DISALLOWED_ENUM_VALUE",
              "TIMEZONE_POLICY",
              "OTHER"
            ]
          },
          "reason_label": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "by_field": {
            "type": "object",
            "description": "필드명 → 건수. 필드명은 EVENT_FIELDS 에 있는 이름만 허용한다.",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "by_event_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "description": "사유별 대표 사례. ★ 레코드 원문이 아니다. 사유·필드명은 항상, 값은 22컬럼에 한해 담는다. 사유(reason_key) 하나당 최대 3건을 권고한다 — 화면이 요구하는 것은 '왜 거부됐나'의 예시이지 목록이 아니다.",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "reason_key",
          "event_type",
          "problems"
        ],
        "additionalProperties": false,
        "properties": {
          "reason_key": {
            "type": "string"
          },
          "event_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "partition_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          },
          "source": {
            "enum": [
              "commerce",
              "simulator",
              "unknown"
            ]
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "offending_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offending_values": {
            "type": "object",
            "description": "★ 거부를 유발한 값. 보안 경계 — 키는 DATA-003 의 22컬럼만 허용한다. 스키마에 없는 필드(금지 필드 포함)의 값은 담을 수 없다. rejected.jsonl 에는 Hidden Trait 이 원문으로 남으므로, 화이트리스트가 없으면 게시물이 ISO-003 을 우회하는 경로가 된다.",
            "propertyNames": {
              "enum": [
                "campaign_id",
                "category",
                "coupon_id",
                "customer_id",
                "customer_version",
                "event_id",
                "event_type",
                "experiment_id",
                "order_amount",
                "order_id",
                "page_type",
                "product_id",
                "quantity",
                "random_seed",
                "service_version",
                "session_duration",
                "session_id",
                "simulator_version",
                "timestamp",
                "treatment_group",
                "treatment_id",
                "unit_price"
              ]
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}

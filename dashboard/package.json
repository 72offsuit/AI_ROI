{
  "name": "airoi-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:generate": "node scripts/design-tokens.mjs --input ../Plan/DESIGN.md --output src/styles/tokens.generated.css",
    "tokens:check": "node scripts/design-tokens.mjs --input ../Plan/DESIGN.md --output src/styles/tokens.generated.css --check",
    "tokens:test": "node scripts/tokens/verify.mjs",
    "fixture:stage": "node scripts/stage-fixture.mjs",
    "check:state-map": "node scripts/check-state-map.mjs",
    "predev": "npm run tokens:generate",
    "prebuild": "npm run tokens:generate",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "shots:empty": "node scripts/stage-fixture.mjs empty-sink && AIROI_FIXTURE=empty-sink playwright test",
    "shots:connected": "node scripts/stage-fixture.mjs commerce-connected && AIROI_FIXTURE=commerce-connected playwright test",
    "shots": "npm run shots:empty && npm run shots:connected && npm run shots:real",
    "shots:real": "AIROI_FIXTURE=real playwright test"
  },
  "dependencies": {
    "next": "16.3.4",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "js-yaml": "4.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

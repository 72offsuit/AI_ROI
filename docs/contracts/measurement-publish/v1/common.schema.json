{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://72offsuit.local/ai-roi/measurement-publish/v1/common.schema.json",
  "title": "측정 산출물 게시 계약 v1 — 공통 정의",
  "description": "src/measurement/ 가 results/ 아래에 게시하는 모든 산출물이 공유하는 봉투(envelope)와 값 표현. 이 스키마의 핵심 목적은 '결손을 0으로 채우지 않는다'(PRD §10.1 · SRS MEA-003 · charter 절대제약 6)를 사람의 규율이 아니라 기계 검사로 만드는 것이다. status 가 unavailable/blocked/not_run 인 지표는 value 가 반드시 null 이어야 하며, 0 을 넣으면 스키마 검증이 실패한다.",
  "$defs": {
    "contract_version": {
      "const": "measurement-publish/v1",
      "description": "게시 계약 버전. 대시보드는 이 값이 다르면 렌더링하지 않고 '계약 버전 불일치'를 표시한다."
    },
    "artifact_name": {
      "enum": [
        "index",
        "ingestion_report",
        "rejection_report",
        "field_coverage_report",
        "kpi_report",
        "data_quality_report",
        "freeze_status"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^MR-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$",
      "description": "게시 실행 식별자. MR-YYYYMMDD-HHMMSS-<8hex>. 같은 게시 실행에서 나온 산출물은 전부 같은 run_id 를 갖는다. 대시보드는 run_id 가 서로 다르면 값을 섞어 표시하지 않는다."
    },
    "kst_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?\\+09:00$",
      "description": "KST 단일 타임존(schema.py TIMEZONE = Asia/Seoul). UTC 표기('Z')는 이 패턴에서 실패한다 — manifest.created_at 이 UTC 인 문제(W1 W-8)를 게시 계층에서 계약으로 막는다."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason_code": {
      "enum": [
        "NO_SOURCE_EVENT",
        "MISSING_FIELD",
        "NO_COST_BASIS",
        "NEEDS_TWO_STRATEGIES",
        "NEEDS_MODEL_OUTPUT",
        "PARAM_UNCONFIRMED",
        "BLOCKED",
        "NOT_RUN",
        "PRECONDITION_MISSING"
      ],
      "description": "계산 불가·미확정 사유. 앞의 7종은 kpi-definition-v1.md §2.4 확정분. NOT_RUN(검사를 실행하지 않았다) 과 PRECONDITION_MISSING(선행 산출물이 없어 검사 대상 자체가 없다) 은 이 계약이 추가 제안하는 2종이며 기획(Joshua) 확인이 필요하다 — api-contracts.md §9 결정 항목 D-15."
    },
    "unit": {
      "enum": [
        "count",
        "krw",
        "krw_per_customer",
        "ratio",
        "days",
        "percentage_point",
        "text",
        "datetime"
      ]
    },
    "ci95": {
      "type": "object",
      "description": "95% 신뢰구간 (kpi-definition-v1.md R-11 · 고객 단위 Bootstrap B=2,000). 표본 부족으로 산출되지 않으면 status 를 inconclusive 로 두고 lower/upper 를 null 로 둔다 — '유의하지 않음'과 구별한다(R-12).",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "inconclusive",
            "not_run"
          ]
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "bootstrap_samples": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "lower",
              "upper",
              "method",
              "bootstrap_samples"
            ],
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inconclusive",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "lower": {
                "type": "null"
              },
              "upper": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "metric_value": {
      "type": "object",
      "description": "지표 한 개의 값 또는 계산 불가 상태. ★ USP-1 의 기계 표현이다. 계산된 값에는 basis 가 반드시 있고, 계산 불가에는 basis 가 있을 수 없다.",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unconfirmed",
            "unavailable",
            "blocked",
            "not_run"
          ],
          "description": "ok=계산됨 · unconfirmed=계산됐으나 파라미터 미확정 · unavailable=근거 부족으로 계산 불가 · blocked=환경 제약으로 실행 못 함(선언된 실행 불가) · not_run=실행하지 않음(아무도 선언하지 않은 공백)"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code"
        },
        "reason_detail": {
          "type": "string",
          "minLength": 1,
          "description": "사람이 읽는 사유 한 줄. 화면의 둘째 줄이다. 근거 수치를 담는다 — 예: '주문 1,204건 중 1,204건에 unit_cost 없음'"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker_ref"
          },
          "description": "이 값을 계산할 수 없게 만든 원인들. 화면이 결손→영향 사슬을 추론하지 않게 한다(DB-012)"
        },
        "derived": {
          "type": "boolean",
          "default": false,
          "description": "저장된 사실이 아니라 규칙에서 유도한 값인가"
        },
        "derivation": {
          "type": "string"
        },
        "params_used": {
          "type": "object",
          "minProperties": 1,
          "description": "status=unconfirmed 일 때 계산에 사용한 미확정 파라미터. R-10"
        },
        "ci95": {
          "$ref": "#/$defs/ci95"
        },
        "value_formatted": {
          "type": "string",
          "minLength": 1,
          "description": "화면이 그대로 출력하는 표시 문자열. 예 '38,400원' · '18.3%' · '1,204건'. 통화·소수 자릿수·천단위 구분은 도메인 규칙이므로 게시 시점에 끝낸다(DB-012) — 화면은 숫자를 포맷하지 않는다. 생성 지점은 contracts.py 의 직렬화 함수 한 곳이며 (status, unit, value) 만으로 결정되는 순수 함수다. 호출자가 넘기지 않는다."
        },
        "limit_note": {
          "type": "string",
          "minLength": 1,
          "description": "값은 나오나 정밀도 한계가 있는 지표의 한 줄 설명. status 는 ok 다. unconfirmed(파라미터 미확정)와 다르다 — 한계는 이벤트가 추가되지 않으면 영원히 남는다. 선택 필드이며 조건부 필수로 만들지 않는다(한계 없는 지표가 전부 실패한다). unit 에서 유도할 수 없는 지표별 사실이므로 호출자가 넘긴다."
        }
      },
      "allOf": [
        {
          "$comment": "계산됨 — 값과 기준이 있고 사유가 없다.",
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit",
              "basis",
              "value_formatted"
            ],
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            },
            "not": {
              "required": [
                "reason_code"
              ]
            }
          }
        },
        {
          "$comment": "미확정 — 값을 내되 사용한 파라미터를 함께 표시한다.",
          "if": {
            "properties": {
              "status": {
                "const": "unconfirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit",
              "basis",
              "reason_code",
              "reason_detail",
              "params_used",
              "value_formatted"
            ],
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "reason_code": {
                "const": "PARAM_UNCONFIRMED"
              }
            }
          }
        },
        {
          "$comment": "★ 계산 불가 — value 는 반드시 null 이고 basis 를 가질 수 없다. 0 을 넣으면 실패한다. ★ not 은 anyOf 다 — required:[a,b] 로 바꾸면 '둘 다 있지는 않다' 가 되어 basis 만 있는 레코드가 통과하고 basis 금지가 사라진다(조용한 회귀). 항목을 더할 때도 anyOf 배열에 더한다.",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "blocked",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason_code",
              "reason_detail"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "basis"
                  ]
                },
                {
                  "required": [
                    "value_formatted"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "derived": {
                "const": true
              }
            },
            "required": [
              "derived"
            ]
          },
          "then": {
            "required": [
              "derivation"
            ]
          }
        },
        {
          "$comment": "비율 지표는 분모를 함께 낸다.",
          "if": {
            "properties": {
              "unit": {
                "const": "ratio"
              },
              "status": {
                "enum": [
                  "ok",
                  "unconfirmed"
                ]
              }
            },
            "required": [
              "unit",
              "status"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "required": [
                  "denominator"
                ]
              }
            }
          }
        },
        {
          "$comment": "분모가 0 이면 계산됨(ok)일 수 없다. 0/0 을 0 으로 표시하는 경로를 막는다.",
          "if": {
            "properties": {
              "basis": {
                "properties": {
                  "denominator": {
                    "const": 0
                  }
                },
                "required": [
                  "denominator"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "not": {
                  "const": "ok"
                }
              }
            }
          }
        }
      ]
    },
    "source_split": {
      "type": "object",
      "description": "출처별 분해 (SRS MEA-002 · kpi-definition-v1.md §2.3). 대시보드는 재분류하지 않는다 — 게시 시점에 끝난다(DB-012).",
      "required": [
        "by_source"
      ],
      "additionalProperties": false,
      "properties": {
        "by_source": {
          "type": "object",
          "required": [
            "commerce",
            "simulator"
          ],
          "additionalProperties": false,
          "properties": {
            "commerce": {
              "$ref": "#/$defs/metric_value"
            },
            "simulator": {
              "$ref": "#/$defs/metric_value"
            }
          }
        },
        "combined": {
          "$ref": "#/$defs/metric_value",
          "$comment": "합산값. 계층 0(수집 건전성)에서만 허용한다."
        }
      }
    },
    "kpi_source_split": {
      "$comment": "R-7 — 두 출처를 합산한 값을 KPI 계층의 기본 표시로 쓰지 않는다. combined 키 자체를 금지한다.",
      "allOf": [
        {
          "$ref": "#/$defs/source_split"
        },
        {
          "not": {
            "required": [
              "combined"
            ]
          }
        }
      ]
    },
    "notice": {
      "type": "object",
      "description": "이 산출물을 읽을 때 함께 보여야 하는 명시 가정·한계. 대시보드가 화면에 표시한다. 가정은 시간이 지나면 사실로 읽히므로 산출물에 붙여 나른다.",
      "required": [
        "code",
        "level",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "level": {
          "enum": [
            "info",
            "assumption",
            "limitation",
            "warning",
            "failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "description": "근거 문서·요구사항 ID"
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "이 산출물이 무엇에서 나왔는가 (SRS DB-013 — 대시보드가 '무엇을 보여주고 있는지' 표시할 수 있게 한다).",
      "required": [
        "schema_version",
        "repo_commit",
        "data_version",
        "simulator_commit",
        "config_hashes",
        "source_root",
        "generated_by"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "src/measurement/schema.py SCHEMA_VERSION. 예: event-schema-v1.0-draft"
        },
        "repo_commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "게시 실행 시점의 이 저장소 커밋 SHA. 얻지 못하면 null 이며 null_reason 에 사유를 적는다."
        },
        "data_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "data/data_version.yaml 의 data_version. 파일이 없으면 null."
        },
        "simulator_commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "SRS ISO-006 · FREEZE-003 대조용. C1 에는 시뮬레이터가 없으므로 null 이며, 0 이나 빈 문자열로 채우지 않는다."
        },
        "null_reason": {
          "type": "object",
          "description": "위 필드 중 null 인 것의 사유. 키는 필드명, 값은 reason_code.",
          "additionalProperties": {
            "$ref": "#/$defs/reason_code"
          }
        },
        "config_hashes": {
          "type": "object",
          "description": "게시 시점에 읽은 config 파일의 SHA-256 (data_spec §15.2). 키는 저장소 기준 상대 경로.",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "source_root": {
          "type": "string",
          "description": "집계 원천 디렉터리 (Event Sink root). 예: data/raw"
        },
        "sink_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$",
          "description": "원천 manifest.json 의 해시. 같은 원천에서 나온 게시물인지 대조한다."
        },
        "generated_by": {
          "type": "string",
          "minLength": 1,
          "description": "★ 이 게시물을 만든 실행 명령. 설계 시점에 지어내지 않고 생성기가 런타임에 자기 실행을 기록한다(리드 판정 · DB-013). 화면은 이 값을 그대로 표시한다."
        },
        "publisher_version": {
          "type": "string",
          "description": "게시 모듈의 버전 또는 커밋. generated_by 와 함께 재현 단서가 된다"
        },
        "lineage": {
          "type": "object",
          "description": "생성 계보 (이슈 #99). data/raw/runs/ 의 실행 기록과 디스크의 파티션을 대조한 결과다. ★ 선택 필드다 — runs/ 가 없는 옛 데이터에서도 게시가 성립해야 하고, 그 경우 verification 이 not_run 이다.",
          "required": [
            "verification",
            "detail",
            "runs"
          ],
          "additionalProperties": false,
          "properties": {
            "verification": {
              "enum": [
                "ok",
                "broken",
                "not_run"
              ],
              "description": "★ status 가 아니라 verification 이다. status 키를 쓰면 verify_core_invariants() 가 이 객체를 지표로 보고 value_formatted·reason_code 를 요구한다. freeze_status 가 같은 이유로 같은 이름을 쓴다. not_run 은 통과가 아니라 '대조하지 않았다' 다."
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "description": "왜 그 판정인지. 비면 화면이 그 자리를 비운다."
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "description": "읽을 수 있었던 실행 기록 수."
            },
            "head_run_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "사슬의 머리 — 아무도 parent 로 지목하지 않은 실행. 사슬이 갈라졌거나 기록이 없으면 null 이며, 추측해서 채우지 않는다."
            }
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "description": "모든 게시물의 공통 머리. 대시보드는 파서를 하나만 갖는다.",
      "required": [
        "contract_version",
        "artifact",
        "run_id",
        "generated_at",
        "timezone",
        "provenance",
        "notices"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/contract_version"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_name"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "generated_at": {
          "$ref": "#/$defs/kst_timestamp"
        },
        "timezone": {
          "const": "Asia/Seoul"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice"
